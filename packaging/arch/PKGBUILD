# Maintainer: Okaza03 <58250719+Okaza03@users.noreply.github.com>
#
# Builds LinuxLink from a release's source code. For the AUR, run `updpkgsums`
# to replace SKIP with the real checksum after bumping pkgver.

pkgname=linuxlink
pkgver=0.2.0
pkgrel=1
pkgdesc="A Wave Link style audio mixer for Linux (PipeWire)"
arch=('x86_64' 'aarch64')
url="https://github.com/Okaza03/LinuxLink"
license=('MIT OR Apache-2.0')
# pactl and parec come with libpulse on Arch.
depends=('gcc-libs' 'glibc' 'libpulse' 'pipewire-pulse' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=('bluez-utils: show the names of Bluetooth devices')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "LinuxLink-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "LinuxLink-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p linuxlink
}

check() {
  cd "LinuxLink-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p linuxlink
}

package() {
  cd "LinuxLink-$pkgver"
  local id=io.github.Okaza03.LinuxLink
  install -Dm755 target/release/linuxlink "$pkgdir/usr/bin/linuxlink"
  install -Dm644 "packaging/linux/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "packaging/linux/$id.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$id.svg"
  for size in 128 256; do
    install -Dm644 "packaging/linux/$id-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$id.png"
  done
  install -Dm644 "packaging/linux/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
